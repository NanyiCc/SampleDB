generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum SampleType {
  TISSUE
  CDNA
  WHOLE_BLOOD
  PLASMA
  CELL
}

enum ExperimentType {
  ENRICHMENT
  ARRAY
  LIGATION
  LIBRARY
  SEQUENCING
  SINGLE_CELL
  TISSUE_SECTION
  SECTION_PLACEMENT
  CDNA_PREP
}

model User {
  id              Int       @id @default(autoincrement())
  username        String    @unique
  passwordHash    String
  displayName     String?
  role            String    @default("USER")
  status          String    @default("PENDING")
  applicationNote String?
  rejectionReason String?
  approvedAt      DateTime?
  approvedById    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  approvedBy      User?     @relation("UserApprovals", fields: [approvedById], references: [id])
  approvedUsers   User[]    @relation("UserApprovals")
  sessions        Session[]

  @@index([status])
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  code      String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  samples   Sample[]
  batches   SampleBatch[]
}

model SampleBatch {
  id          Int      @id @default(autoincrement())
  projectCode String
  name        String
  createdBy   String?
  count       Int
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectCode], references: [code])
  samples     Sample[]

  @@index([projectCode])
  @@index([createdAt])
}

model Sample {
  id           String          @id
  hashCode     String?
  tubeId       String?         @unique
  batchId      Int?
  projectCode  String
  sequence     Int
  name         String
  receivedAt   DateTime
  storedAt     DateTime        @default(now())
  type         SampleType
  remark       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  batch        SampleBatch?     @relation(fields: [batchId], references: [id])
  project      Project         @relation(fields: [projectCode], references: [code])
  detail       SampleDetail?

  @@unique([projectCode, sequence])
  @@index([hashCode])
  @@index([projectCode])
  @@index([storedAt])
}

model SampleDetail {
  id                           Int      @id @default(autoincrement())
  sampleId                     String   @unique
  volume                       Float?
  concentration                Float?
  storageLocation              String?
  tissueSource                 String?
  technologyType               String?
  originalFragmentDistribution String?
  experimentMethod             String?
  loadingVolume                Float?
  remark                       String?
  tubeRecordName               String?
  freshBloodStatus             String?
  frozenWholeBloodTubeCount    Int?
  frozenPlasmaTubeCount        Int?
  frozenCellTubeCount          Int?
  qualityControlCellCount      String?
  storageCondition             String?
  preservationMedium           String?
  experimentDate               String?
  experimentLocation           String?
  experimenter                 String?
  checker                      String?
  patientGroup                 String?
  projectTeacher               String?
  sample                       Sample   @relation(fields: [sampleId], references: [id], onDelete: Cascade)
}

model SamplingRegistration {
  id                 Int                @id @default(autoincrement())
  title              String?
  projectCode        String?
  experimentType     ExperimentType
  operator           String
  remark             String?
  chipNumber         String?            @unique
  sequencingStrategy String?
  storagePath        String?
  registeredAt       DateTime           @default(now())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  entries            SamplingEntry[]
  sequencingResult   SequencingResult?

  @@index([registeredAt])
  @@index([projectCode])
}

model SamplingEntry {
  id               Int                   @id @default(autoincrement())
  registrationId   Int
  sourceSampleId   String
  // Legacy field retained for existing registrations created before units were configurable.
  inputAmountNg    Float?
  inputAmount      Float?
  inputUnit        String?
  derivedSampleId  String                @unique
  registration     SamplingRegistration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  derivedSample    DerivedSample         @relation(fields: [derivedSampleId], references: [id], onDelete: Cascade)

  @@index([sourceSampleId])
  @@index([registrationId])
}

model DerivedSample {
  id              String            @id
  hashCode        String?
  sourceSampleId  String
  experimentType  ExperimentType
  suffix          String
  sequence        Int
  createdAt       DateTime          @default(now())
  entry           SamplingEntry?
  result          ExperimentResult?

  @@unique([sourceSampleId, experimentType, sequence])
  @@index([hashCode])
  @@index([sourceSampleId, experimentType])
}

model ExperimentResult {
  id                    Int            @id @default(autoincrement())
  derivedSampleId       String         @unique
  experimentType         ExperimentType
  volume                Float?
  concentration         Float?
  storageLocation       String?
  fragmentDistribution  String?
  experimentMethod      String?
  generationStrategy    String?
  inputAmount           Float?
  outputVolume          Float?
  libraryDuration       String?
  libraryStrategy       String?
  absorbance260280      Float?
  absorbance260230      Float?
  barcode               String?
  sliceCount            Int?
  sliceDetails          String?
  chipId                String?
  imageStorageLocation  String?
  qc                    String?
  fragmentLength        String?
  experimenter          String?
  experimentDate        String?
  cellCountInstrument   String?
  viability             Float?
  cellConcentrationDirect  Float?
  cellConcentrationDiluted Float?
  averageDiameter       Float?
  aggregationRate       Float?
  nucleatedRate         Float?
  expectedCellCapture   String?
  loadingCellCount      String?
  loadingVolume         Float?
  csbVolume             Float?
  resuspensionBuffer    String?
  riskOnInstrument      String?
  remainingSample       String?
  hasCryopreservedCells String?
  experimentOperation   String?
  libraryDate           String?
  pipStorageLocation    String?
  cdnaConcentration     Float?
  cdnaFragmentLength    String?
  cdnaPeakPath          String?
  libraryConcentration  Float?
  libraryFragmentLength String?
  libraryPeakPath       String?
  remark                String?
  submittedAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  derivedSample          DerivedSample  @relation(fields: [derivedSampleId], references: [id], onDelete: Cascade)
}

model SequencingResult {
  id                 Int                  @id @default(autoincrement())
  registrationId     Int                  @unique
  dataAmount         String?
  uploadPath         String?
  sequencingStrategy String?
  barcode            Int?
  remark             String?
  submittedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  registration       SamplingRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}
