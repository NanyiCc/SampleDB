{
  "name": "sampledb",
  "version": "0.1.0-dev.2",
  "private": true,
  "scripts": {
    "dev": "node scripts/portable/dev.mjs --local",
    "dev:lan": "node scripts/portable/dev.mjs --lan",
    "build": "prisma generate && next build",
    "build:pages": "node scripts/build-pages.mjs",
    "test": "node --test tests/*.test.cjs",
    "start": "node scripts/portable/start.mjs",
    "start:lan": "node scripts/portable/start.mjs --lan --port 3002",
    "start:next": "next start",
    "db:push": "prisma db push",
    "prisma:generate": "prisma generate",
    "portable:pack": "node scripts/portable/create-package.mjs",
    "portable:restore": "node scripts/portable/restore.mjs",
    "portable:restore:start": "node scripts/portable/restore.mjs --start",
    "portable:start": "node scripts/portable/start.mjs",
    "portable:start:local": "node scripts/portable/start.mjs --local",
    "portable:start:lan": "node scripts/portable/start.mjs --lan",
    "admin:credential:path": "node scripts/portable/admin-credentials.mjs --show-path",
    "admin:credential:reset": "node scripts/portable/admin-credentials.mjs --reset"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prisma": "^6.0.0",
    "typescript": "latest"
  }
}
